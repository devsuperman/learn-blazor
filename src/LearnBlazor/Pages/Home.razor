@page "/"
@inject ContentService Content
@inject ProgressService Progress

<PageTitle>Learn Blazor</PageTitle>

<h1>Learn Blazor (.NET 10)</h1>
<p class="lead">
    One level at a time. The goal: read AI-generated Blazor code with confidence and answer basic interview questions.
</p>

<section class="card">
    <h2>Levels</h2>
    @if (_topics is null)
    {
        <p>Loading…</p>
    }
    else
    {
        <ul class="level-list">
            @foreach (var topic in _topics)
            {
                <li class="level-item @(topic.Available ? "" : "level-locked")">
                    <span class="level-num">@topic.Number</span>
                    <div class="level-body">
                        @if (topic.Available)
                        {
                            <a href="@($"topic/{topic.Id}")" class="level-title">@topic.Title</a>
                        }
                        else
                        {
                            <span class="level-title">@topic.Title</span>
                        }
                        <span class="level-summary">@topic.Summary</span>
                    </div>
                    @if (topic.Available)
                    {
                        <StatusBadge Status="@(_status.GetValueOrDefault(topic.Id))" ShowText="true" />
                    }
                    else
                    {
                        <span class="badge badge-soon">Coming soon</span>
                    }
                </li>
            }
        </ul>
    }
</section>

<section class="card">
    <h2>The study loop</h2>
    <p>Each level page has one tab per step. Work through them in order, at your own pace.</p>
    <ol class="loop">
        <li><strong>Theory:</strong> read about one concept only.</li>
        <li><strong>Predict:</strong> read short snippets and pick what they will do. Your first pick counts.</li>
        <li><strong>Practice:</strong> write code in the textbox and press <em>Check</em>. Type it yourself: no copy-paste.</li>
        <li><strong>Quiz:</strong> multiple-choice questions, without the theory open.</li>
    </ol>
    <p>Then answer the <strong>interview</strong> questions aloud (under 30 s each) and in writing.</p>
</section>

<section class="card">
    <h2>Passing a level</h2>
    <ul>
        <li>Every practice exercise passes all its checks.</li>
        <li>The whole quiz is answered with at least 80% correct. You can retake it.</li>
        <li>From Level 3 on, start each session by redoing a practice exercise from 2 levels back.</li>
        <li>Code copied from AI does not count.</li>
    </ul>
    <p class="muted">
        Everything happens on this site: no local project needed. The checks look for the key parts of each concept with simple rules;
        they don't compile your code. Your answers and code are saved only in this browser.
    </p>
</section>

@code {
    private IReadOnlyList<TopicSummary>? _topics;
    private readonly Dictionary<string, TopicStatus> _status = [];

    protected override async Task OnInitializedAsync()
    {
        _topics = await Content.GetTopicsAsync();
        foreach (var topic in _topics.Where(t => t.Available))
            _status[topic.Id] = (await Progress.GetAsync(topic.Id)).Status;
    }
}
