@if (Progress.TheoryLocked)
{
    <div class="callout callout-warn">
        <strong>Theory is locked while the challenge runs.</strong>
        Solve it from memory first. <a href="@ChallengeUrl">Back to the challenge</a>.
    </div>
}
else
{
    <Markdown Text="@Theory" />
}

@code {
    [Parameter, EditorRequired] public string Theory { get; set; } = "";
    [Parameter, EditorRequired] public LessonProgress Progress { get; set; } = default!;
    [Parameter, EditorRequired] public string ChallengeUrl { get; set; } = "";
}
