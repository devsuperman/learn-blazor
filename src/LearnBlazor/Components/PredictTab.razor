<p class="muted">
    Read each snippet and pick what it will do. Your first pick counts, so think before you click.
    A wrong prediction is fine: it shows you what to look at in practice.
</p>

<p><strong>@Correct / @Lesson.Predict.Count correct</strong> (@Answered answered)</p>

@foreach (var item in Lesson.Predict)
{
    <ChoiceCard Question="item" Heading="@($"{item.Id} · {item.Title}")"
                Chosen="@(Progress.PredictChoices.TryGetValue(item.Id, out var c) ? c : null)"
                OnChoose="i => ChooseAsync(item.Id, i)" />
}

@code {
    [Parameter, EditorRequired] public Lesson Lesson { get; set; } = default!;
    [Parameter, EditorRequired] public LessonProgress Progress { get; set; } = default!;
    [Parameter] public EventCallback OnChange { get; set; }

    private int Answered => Lesson.Predict.Count(q => Progress.PredictChoices.ContainsKey(q.Id));
    private int Correct => Lesson.Predict.Count(q => Progress.PredictChoices.TryGetValue(q.Id, out var c) && c == q.Correct);

    private Task ChooseAsync(string id, int index)
    {
        if (!Progress.PredictChoices.TryAdd(id, index)) return Task.CompletedTask;
        return OnChange.InvokeAsync();
    }
}
