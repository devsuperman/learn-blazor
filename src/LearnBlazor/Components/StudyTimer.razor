@implements IDisposable

<div class="timer @(Remaining <= TimeSpan.Zero ? "timer-done" : "")" role="timer" aria-live="off">
    <span class="timer-label">@Label</span>
    <span class="timer-time">@Format(Remaining)</span>
    @if (Remaining <= TimeSpan.Zero)
    {
        <span class="timer-msg">Time's up: move on.</span>
    }
    @if (_running)
    {
        <button class="btn btn-small" @onclick="Pause">Pause</button>
    }
    else if (Remaining > TimeSpan.Zero)
    {
        <button class="btn btn-small btn-primary" @onclick="Start">@(Remaining == Total ? "Start" : "Resume")</button>
    }
    <button class="btn btn-small btn-ghost" @onclick="Reset" disabled="@(Remaining == Total && !_running)">Reset</button>
</div>

@code {
    private Timer? _timer;
    private bool _running;
    private DateTime _endsAt;
    private TimeSpan _left;

    [Parameter, EditorRequired] public int Minutes { get; set; }
    [Parameter] public string Label { get; set; } = "Timer";

    private TimeSpan Total => TimeSpan.FromMinutes(Minutes);
    private TimeSpan Remaining => _running ? Max(_endsAt - DateTime.UtcNow) : _left;

    protected override void OnInitialized() => _left = Total;

    private void Start()
    {
        _endsAt = DateTime.UtcNow + _left;
        _running = true;
        _timer ??= new Timer(_ => InvokeAsync(Tick), null, 0, 500);
    }

    private void Pause()
    {
        _left = Remaining;
        _running = false;
    }

    private void Reset()
    {
        _running = false;
        _left = Total;
    }

    private void Tick()
    {
        if (!_running) return;
        if (Remaining <= TimeSpan.Zero)
        {
            _running = false;
            _left = TimeSpan.Zero;
        }
        StateHasChanged();
    }

    private static TimeSpan Max(TimeSpan t) => t < TimeSpan.Zero ? TimeSpan.Zero : t;

    private static string Format(TimeSpan t) =>
        $"{(int)t.TotalMinutes:00}:{t.Seconds:00}";

    public void Dispose() => _timer?.Dispose();
}
