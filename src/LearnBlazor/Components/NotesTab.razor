@inject IJSRuntime JS

<p class="muted">Three lines, in your own words. Short is better.</p>

<article class="card">
    <label class="field-label" for="note-what">What it is</label>
    <textarea id="note-what" rows="2" value="@Progress.NoteWhat"
              @oninput="e => Set(v => Progress.NoteWhat = v, e)"></textarea>

    <label class="field-label" for="note-differs">How it differs from what I know (Razor Pages / MVC)</label>
    <textarea id="note-differs" rows="2" value="@Progress.NoteDiffers"
              @oninput="e => Set(v => Progress.NoteDiffers = v, e)"></textarea>

    <label class="field-label" for="note-gotcha">One gotcha</label>
    <textarea id="note-gotcha" rows="2" value="@Progress.NoteGotcha"
              @oninput="e => Set(v => Progress.NoteGotcha = v, e)"></textarea>
</article>

<article class="card">
    <label class="field-label" for="note-free">Free notes (practice observations, questions, anything)</label>
    <textarea id="note-free" rows="8" value="@Progress.FreeNotes"
              @oninput="e => Set(v => Progress.FreeNotes = v, e)"></textarea>
</article>

<div class="actions">
    <button class="btn" @onclick="DownloadAsync">Download all my answers (.md)</button>
    <button class="btn btn-danger" @onclick="ResetAsync">Reset this level</button>
</div>
<p class="muted">Saved automatically in this browser only. Download a copy if you switch devices or clear browser data.</p>

@code {
    [Parameter, EditorRequired] public Lesson Lesson { get; set; } = default!;
    [Parameter, EditorRequired] public LessonProgress Progress { get; set; } = default!;
    [Parameter] public EventCallback OnChange { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }

    private Task Set(Action<string> assign, ChangeEventArgs e)
    {
        assign(e.Value?.ToString() ?? "");
        return OnChange.InvokeAsync();
    }

    private async Task DownloadAsync()
    {
        var md = NotesExport.ToMarkdown(Lesson, Progress);
        await JS.InvokeVoidAsync("learnBlazor.download", $"{Lesson.Id}-notes.md", md);
    }

    private async Task ResetAsync()
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Erase all your answers for Level {Lesson.Number}? This cannot be undone."))
            await OnReset.InvokeAsync();
    }
}
