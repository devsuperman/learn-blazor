@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav

<div class="shell @(_menuOpen ? "menu-open" : "")">
    <header class="topbar">
        <button class="menu-toggle" @onclick="ToggleMenu" aria-label="Toggle menu" aria-expanded="@_menuOpen">☰</button>
        <a class="brand" href="">Learn Blazor</a>
    </header>

    <aside class="sidebar">
        <a class="brand brand-side" href="">Learn Blazor</a>
        <NavMenu />
    </aside>

    <div class="backdrop" @onclick="CloseMenu"></div>

    <main class="content">
        @Body
    </main>
</div>

@code {
    private bool _menuOpen;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;

    // Close the mobile menu after picking a topic.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!_menuOpen) return;
        _menuOpen = false;
        StateHasChanged();
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
